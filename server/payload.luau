                consts[i] = { 3, enc_str, salt }
            end
        end
        proto.consts = consts

        -- Upvalues
        local num_upvals = read_u32()
        local upvalues = {}
        for i = 1, num_upvals do
            local in_stack = (read_u8() == 1)
            local index = read_u16()
            upvalues[i] = { in_stack = in_stack, index = index }
        end
        proto.upvalues = upvalues

        -- Child Prototypes
        local num_protos = read_u32()
        local protos = {}
        for i = 1, num_protos do
            protos[i] = read_proto()
        end
        proto.protos = protos

        return proto
    end

    return read_proto()
end

local ROOT_PROTO = deserialize_payload(PAYLOAD)

local function run_vm(proto, env, upvalues, ...)
    local code = proto.code
    local consts = proto.consts
    local protos = proto.protos
    local R = {}
    local open_upvalues = {}
    local has_open_upvals = false
    local varargs = { ... }

    local function get_k(idx)
        local item = consts[idx]
        if item == nil then return nil end
        if type(item) == "table" and item[1] == 3 then
            local raw = item[2]
            local salt = item[3]
            local len = #raw
            local bytes = {}
            for c_idx = 0, len - 1 do
                local b = string_byte(raw, c_idx + 1)
                bytes[c_idx + 1] = bit32_bxor(b, bit32_bxor(bit32_band(salt + c_idx * 7, 0xFF), 0x5A))
            end
            local res
            if len <= 100 then
                res = string_char(unpack(bytes, 1, len))
            else
                local chunks = {}
                local chunk_count = 0
                for start_i = 1, len, 64 do
                    local end_i = start_i + 63
                    if end_i > len then end_i = len end
                    chunk_count = chunk_count + 1
                    chunks[chunk_count] = string_char(unpack(bytes, start_i, end_i))
                end
                res = table_concat(chunks)
            end
            consts[idx] = res
            return res
        end
        return item
    end

    for i = 1, proto.num_params do
        R[i - 1] = varargs[i]
    end

    local pc = 1
    local mult_ret = {}
    local top_reg = proto.max_stack_size
    local rolling_hash = 0x12345678

    while true do
        local inst = code[pc]
        pc = pc + 1
        local op = inst[1]

            -- Rolling state & embedded dispatcher anti-tamper verification
            rolling_hash = bit32_band(rolling_hash * 31 + op + pc, 0xFFFFFFFF)
            if bit32_band(pc, 0x3F) == 0 then
                if bit32_bxor(100, 200) ~= 172 or string_unpack("<I2", "\1\0") ~= 1
                    or (debug and debug.info and (debug.info(bit32_bxor, "s") ~= "[C]" or debug.info(string_char, "s") ~= "[C]")) then
                    pc = pc + bit32_band(rolling_hash, 0x1F) + 1337
                    rolling_hash = 0
                end
            end
            
            if op < 108 then
                if op < 45 then
                    if op < 26 then
                        if op < 11 then
                            if op == 9 then
                local base_reg, offset = inst[2], inst[3]
                pc = pc + offset
                            end
                        else
                            if op == 11 then
                local name_idx, src = inst[2], inst[3]
                local name = get_k(name_idx + 1)
                env[name] = R[src]
                            elseif op == 16 then
                local close_from = inst[2]
                for reg_idx, upval in pairs(open_upvalues) do
                    if reg_idx >= close_from then
                        upval[1] = R[reg_idx]
                        open_upvalues[reg_idx] = nil
                    end
                end
                            end
                        end
                    else
                        if op < 37 then
                            if op == 26 then
                local func_reg, num_args, num_rets = inst[2], inst[3], inst[4]
                local fn = R[func_reg]
                local rets
                if num_args == 0 then
                    local args = {}
                    local c = 0
                    for i = func_reg + 1, top_reg do
                        c = c + 1
                        args[c] = R[i]
                    end
                    rets = { fn(unpack(args, 1, c)) }
                elseif num_args == 1 then
                    rets = { fn() }
                else
                    local args = {}
                    local count = num_args - 1
                    for i = 1, count do
                        args[i] = R[func_reg + i]
                    end
                    rets = { fn(unpack(args, 1, count)) }
                end
                if num_rets == 0 then
                    mult_ret = rets
                    top_reg = func_reg + #rets - 1
                elseif num_rets > 1 then
                    for i = 1, num_rets - 1 do
                        local r_idx = func_reg + i - 1
                        R[r_idx] = rets[i]
                        if has_open_upvals and open_upvalues[r_idx] then open_upvalues[r_idx][1] = rets[i] end
                    end
                end
                            elseif op == 35 then
                local dest, tbl_reg, name_idx = inst[2], inst[3], inst[4]
                local tbl = R[tbl_reg]
                local key = get_k(name_idx + 1)
                R[dest + 1] = tbl
                R[dest] = tbl[key]
                if has_open_upvals then
                    if open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                    if open_upvalues[dest + 1] then open_upvalues[dest + 1][1] = R[dest + 1] end
                end
                            end
                        else
                            if op == 37 then
                local init_reg, offset = inst[2], inst[3]
                local step = R[init_reg + 2]
                local idx = R[init_reg] + step
                local limit = R[init_reg + 1]
                R[init_reg] = idx
                if (step > 0 and idx <= limit) or (step <= 0 and idx >= limit) then
                    pc = pc + offset
                end
                            elseif op == 44 then
                local left_reg, right_reg, flags = inst[2], inst[3], inst[4]
                local left = R[left_reg]
                local right = (bit32_band(flags, 2) ~= 0) and get_k(right_reg + 1) or R[right_reg]
                local invert = (bit32_band(flags, 1) ~= 0)
                if (left <= right) == invert then
                    pc = pc + 1
                end
                            end
                        end
                    end
                else
                    if op < 61 then
                        if op < 56 then
                            if op == 45 then
                local init_reg, offset = inst[2], inst[3]
                local step = R[init_reg + 2]
                local idx = R[init_reg]
                local limit = R[init_reg + 1]
                if (step > 0 and idx > limit) or (step <= 0 and idx < limit) then
                    pc = pc + offset
                end
                            end
                        else
                            if op == 56 then
                local dest, left_reg, right_reg, flags = inst[2], inst[3], inst[4], inst[5]
                local left = R[left_reg]
                local right = (bit32_band(flags, 0x80) ~= 0) and get_k(right_reg + 1) or R[right_reg]
                local op_tag = bit32_band(flags, 0x0F)
                local res
                if op_tag == 0 then res = left + right
                elseif op_tag == 1 then res = left - right
                elseif op_tag == 2 then res = left * right
                elseif op_tag == 3 then res = left / right
                elseif op_tag == 4 then res = left % right
                elseif op_tag == 5 then res = left ^ right
                elseif op_tag == 6 then res = left .. right
                end
                R[dest] = res
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = res end
                            elseif op == 57 then
                local reg, invert = inst[2], (inst[3] == 1)
                local val = R[reg]
                if (not val) == invert then
                    pc = pc + 1
                end
                            end
                        end
                    else
                        if op < 68 then
                            if op == 61 then
                local dest, proto_idx = inst[2], inst[3]
                local child_proto = protos[proto_idx + 1]
                local child_upvals = {}
                for u_idx, desc in ipairs(child_proto.upvalues) do
                    if desc.in_stack then
                        local r_idx = desc.index
                        if not open_upvalues[r_idx] then
                            open_upvalues[r_idx] = { R[r_idx] }
                            has_open_upvals = true
                        end
                        child_upvals[u_idx] = open_upvalues[r_idx]
                    else
                        child_upvals[u_idx] = upvalues[desc.index + 1]
                    end
                end
                local closure_fn = function(...)
                    return run_vm(child_proto, env, child_upvals, ...)
                end
                R[dest] = closure_fn
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = closure_fn end
                            elseif op == 64 then
                local dest, count = inst[2], inst[3]
                local num_fixed = proto.num_params
                local num_available = #varargs - num_fixed
                if num_available < 0 then num_available = 0 end
                if count == 0 then
                    for i = 1, num_available do
                        local r_idx = dest + i - 1
                        local val = varargs[num_fixed + i]
                        R[r_idx] = val
                        if has_open_upvals and open_upvalues[r_idx] then open_upvalues[r_idx][1] = val end
                    end
                    top_reg = dest + num_available - 1
                else
                    for i = 1, count - 1 do
                        local r_idx = dest + i - 1
                        local val = varargs[num_fixed + i]
                        R[r_idx] = val
                        if has_open_upvals and open_upvalues[r_idx] then open_upvalues[r_idx][1] = val end
                    end
                end
                            end
                        else
                            if op == 68 then
                local dest, count = inst[2], inst[3]
                for i = dest, dest + count - 1 do
                    R[i] = nil
                    if has_open_upvals and open_upvalues[i] then open_upvalues[i][1] = nil end
                end
                            elseif op == 89 then
                local dest, name_idx = inst[2], inst[3]
                local name = get_k(name_idx + 1)
                R[dest] = env[name]
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                            end
                        end
                    end
                end
            else
                if op < 193 then
                    if op < 147 then
                        if op < 110 then
                            if op == 108 then
                local left_reg, right_reg, flags = inst[2], inst[3], inst[4]
                local left = R[left_reg]
                local right = (bit32_band(flags, 2) ~= 0) and get_k(right_reg + 1) or R[right_reg]
                local invert = (bit32_band(flags, 1) ~= 0)
                if (left == right) == invert then
                    pc = pc + 1
                end
                            end
                        else
                            if op == 110 then
                local dest, val, skip = inst[2], inst[3], inst[4]
                R[dest] = (val == 1)
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                if skip == 1 then pc = pc + 1 end
                            elseif op == 112 then
                local dest, tbl_reg, key_reg, is_k = inst[2], inst[3], inst[4], inst[5]
                local tbl = R[tbl_reg]
                local key = (is_k == 1) and get_k(key_reg + 1) or R[key_reg]
                R[dest] = tbl[key]
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                            end
                        end
                    else
                        if op < 174 then
                            if op == 147 then
                local start_reg, count = inst[2], inst[3]
                if count == 1 then
                    return
                elseif count > 1 then
                    local out = {}
                    local n = count - 1
                    for i = 1, n do
                        out[i] = R[start_reg + i - 1]
                    end
                    return unpack(out, 1, n)
                else
                    local out = {}
                    local n = 0
                    for i = start_reg, top_reg do
                        n = n + 1
                        out[n] = R[i]
                    end
                    for _, v in ipairs(mult_ret) do
                        n = n + 1
                        out[n] = v
                    end
                    return unpack(out, 1, n)
                end
                            elseif op == 160 then
                local dest = inst[2]
                R[dest] = {}
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                            end
                        else
                            if op == 174 then
                local dest, upv_idx = inst[2], inst[3]
                R[dest] = upvalues[upv_idx + 1][1]
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                            elseif op == 183 then
                local left_reg, right_reg, flags = inst[2], inst[3], inst[4]
                local left = R[left_reg]
                local right = (bit32_band(flags, 2) ~= 0) and get_k(right_reg + 1) or R[right_reg]
                local invert = (bit32_band(flags, 1) ~= 0)
                if (left < right) == invert then
                    pc = pc + 1
                end
                            end
                        end
                    end
                else
                    if op < 217 then
                        if op < 199 then
                            if op == 193 then
                local tbl_reg, key_reg, val_reg, flags = inst[2], inst[3], inst[4], inst[5]
                local tbl = R[tbl_reg]
                local key = (bit32_band(flags, 1) ~= 0) and get_k(key_reg + 1) or R[key_reg]
                local val = (bit32_band(flags, 2) ~= 0) and get_k(val_reg + 1) or R[val_reg]
                tbl[key] = val
                            elseif op == 196 then
                local dest, k_idx = inst[2], inst[3]
                R[dest] = get_k(k_idx + 1)
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                            end
                        else
                            if op == 199 then
                local dest, src, invert = inst[2], inst[3], (inst[4] == 1)
                local val = R[src]
                if (not val) ~= invert then
                    R[dest] = val
                    if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = val end
                else
                    pc = pc + 1
                end
                            elseif op == 205 then
                local offset = inst[3]
                pc = pc + offset
                            end
                        end
                    else
                        if op < 236 then
                            if op == 217 then
                local dest, src_reg, op_tag = inst[2], inst[3], inst[4]
                local src = R[src_reg]
                local res
                if op_tag == 0 then res = not src
                elseif op_tag == 1 then res = -src
                elseif op_tag == 2 then res = #src
                end
                R[dest] = res
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = res end
                            elseif op == 223 then
                local dest, src = inst[2], inst[3]
                R[dest] = R[src]
                if has_open_upvals and open_upvalues[dest] then open_upvalues[dest][1] = R[dest] end
                            end
                        else
                            if op == 236 then
                local upv_idx, src = inst[2], inst[3]
                upvalues[upv_idx + 1][1] = R[src]
                            elseif op == 237 then
                local base_reg, var_start, num_vars = inst[2], inst[3], inst[4]
                local gen = R[base_reg]
                local state = R[base_reg + 1]
                local var = R[base_reg + 2]
                local res = { gen(state, var) }
                for i = 1, num_vars do
                    local r_idx = var_start + i - 1
                    R[r_idx] = res[i]
                    if has_open_upvals and open_upvalues[r_idx] then open_upvalues[r_idx][1] = res[i] end
                end
                if R[var_start] ~= nil then
                    R[base_reg + 2] = R[var_start]
                else
                    pc = pc + 1
                end
                            end
                        end
                    end
                end
            end

    end
end

return run_vm(ROOT_PROTO, _ENV, {}, ...)
